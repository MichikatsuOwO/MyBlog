# Public API address used by Next.js at build time (use http://localhost:8787 locally)
NEXT_PUBLIC_API_URL=http://localhost:8787

# Hono server
PORT=8787
ALLOWED_ORIGIN=http://localhost:3000
ADMIN_PASSWORD=change-this-to-a-long-password
ADMIN_TOKEN_SECRET=change-this-to-a-long-random-secret
POSTGRES_URL=postgres://paperlane:change-this-db-password@db:5432/paperlane

# S3-compatible storage: works with Alibaba Cloud OSS when its S3 endpoint is used
S3_REGION=oss-cn-hangzhou
S3_BUCKET=your-bucket
S3_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://your-cdn-domain
